# Database (SQLite by default for local dev, Postgres for production)
DATABASE_URL=sqlite:///./devhub.db

# Redis (optional, used for cache/tasks)
REDIS_URL=redis://localhost:6379

# JWT
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=DevHub
DEBUG=true
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL used in reset / verification links
FRONTEND_URL=http://localhost:5173

# Optional integrations (leave blank to disable)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=devhub-files
AWS_REGION=us-east-1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
SENTRY_DSN=
